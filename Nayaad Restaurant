        }

        .header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .location-tag {
            background: rgba(255,255,255,0.2);
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            margin-top: 0.5rem;
            font-size: 0.9rem;
        }

        /* Navigation */
        .nav {
            background: #2c2c2c;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 2rem;
            padding: 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
            padding: 0.5rem 1rem;
            transition: 0.3s;
        }

        .nav a:hover {
            background: #8B0000;
            border-radius: 5px;
        }

        /* Container */
        .container {
            max-width: 1200px;
            margin: auto;
            padding: 2rem;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url(&#39;https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200&#39;);
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 4rem 2rem;
            border-radius: 20px;
            margin-bottom: 2rem;
        }

        .hero h2 {
            font-size: 2.5rem;
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
        }

        .hero-badge {
            background: #8B0000;
            display: inline-block;
            padding: 0.5rem 1.5rem;
            border-radius: 50px;
            font-weight: bold;
        }

        /* Section Titles */
        .section-title {
            text-align: center;
            font-size: 2rem;
            color: #8B0000;
            margin: 2rem 0 1.5rem 0;
            padding-bottom: 0.5rem;
            border-bottom: 3px solid #8B0000;
            display: inline-block;
            width: auto;
        }

        .title-wrapper {
            text-align: center;
        }

        /* Menu Grid */
        .menu-category {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        }

        .category-title {
            font-size: 1.8rem;
            color: #c0392b;
            margin-bottom: 1rem;
            padding-left: 0.5rem;
            border-left: 5px solid #c0392b;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1rem;
        }

        .menu-item {
            background: #fef9f0;
            padding: 1rem;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #eee;
        }

        .menu-item-info h3 {
            font-size: 1.1rem;
            color: #333;
        }

        .menu-item-info p {
            font-size: 0.85rem;
            color: #777;
            margin-top: 0.25rem;
        }

        .price {
            font-weight: bold;
            color: #2c7a2c;
            font-size: 1.1rem;
        }

